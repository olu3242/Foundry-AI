# --- Public (inlined into the client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token). >= 16 chars.
CRON_SECRET=
# Pepper for hashing Passport share tokens. >= 16 chars. Rotating it revokes all links.
PASSPORT_TOKEN_PEPPER=

# AI (extraction, recommendations). Without a key, captures stay in "received" and are retried.
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-opus-5-5

# Billing (programs / sponsors). Optional until programs go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROGRAM_PRICE_ID=

# Observability. Optional; Sentry is a no-op without a DSN.
NEXT_PUBLIC_SENTRY_DSN=

# --- B41 hardening ---
# Set APP_ENV=production on the production deployment: the server then refuses to boot with
# unsafe config (see docs/RUNBOOK.md). Local/test only: allow egress to private hosts (test doubles).
APP_ENV=
ALLOW_PRIVATE_EGRESS=

# B42 messaging (owner reminders). Unset = messages are suppressed as no_provider_configured.
MESSAGING_ENABLED=1
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=
AFRICASTALKING_CALLBACK_TOKEN=

# B43 payments (Paystack). Unset = no online payment; manual references still work.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCIES=GHS,NGN
PAYSTACK_CUSTOMER_EMAIL_DOMAIN=

# B44 FX feed (Open Exchange Rates). Unset = placeholder rates, USD totals marked not reportable.
FX_PROVIDER=
FX_API_KEY=
