# --- Public (inlined into the client bundle) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server only ---
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for /api/cron/* (Vercel Cron sends it as a Bearer token). >= 16 chars.
CRON_SECRET=
# Pepper for hashing Passport share tokens. >= 16 chars. Rotating it revokes all links.
PASSPORT_TOKEN_PEPPER=

# AI (extraction, recommendations). Without a key, captures stay in "received" and are retried.
ANTHROPIC_API_KEY=
AI_EXTRACTION_MODEL=claude-sonnet-5-5

# Billing (programs / sponsors). Optional until programs go live.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROGRAM_PRICE_ID=

# Observability. Optional; Sentry is a no-op without a DSN.
NEXT_PUBLIC_SENTRY_DSN=
